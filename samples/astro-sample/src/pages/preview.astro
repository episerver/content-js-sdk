---
// Skip pre-rendering for preview page since it's dynamic
export const prerender = false;

import type { PreviewParams } from '@optimizely/cms-sdk';
import { OptimizelyPreview } from '@optimizely/cms-sdk/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { initOptimizely, getClient as getInitializedClient } from '@/lib/optimizely';
import ContentPage from '@/components/react/ContentPage';

initOptimizely();

const searchParams = Astro.url.searchParams;
const previewParams = Object.fromEntries(searchParams.entries());

const client = getInitializedClient();
const content = await client.getPreviewContent(previewParams as PreviewParams);
---

<BaseLayout>
  <OptimizelyPreview cmsUrl={import.meta.env.OPTIMIZELY_CMS_URL}>
    <ContentPage content={content} />
  </OptimizelyPreview>
</BaseLayout>
