---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <main>
    <div class="under-construction">
      <h1>🚀 Astro Sample</h1>
      <p>
        This is an Optimizely CMS sample built with Astro and React. Configure
        your CMS connection in <code>.env.local</code> to see your content.
      </p>
      <p>
        Visit the CMS to create content and it will appear at generated routes
        like <code>/your-content-path/</code>
      </p>
    </div>
  </main>
</BaseLayout>
