# Base URL of your CMS instance
# Example: https://example.cms.optimizely.com/
OPTIMIZELY_CMS_URL=

# Content Graph endpoint (optional)
# Use to specify a non-production instance or different version
# Default: https://cg.optimizely.com/content/v2
# OPTIMIZELY_GRAPH_GATEWAY=

# Content Graph authentication key
# Found in: CMS instance > Settings > API Keys
OPTIMIZELY_GRAPH_SINGLE_KEY=

# CLI client credentials for syncing manifest data
# Create in: CMS instance > Settings > API Keys > Create API key
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=

# Set by Optimizely front-end hosting. Set them yourself only to test the
# webhook and the shared cache somewhere else.
#
# Graph webhook registration and the callback's API key
# OPTIMIZELY_GRAPH_APP_KEY=
# OPTIMIZELY_GRAPH_SECRET=
# OPTIMIZELY_GRAPH_CALLBACK_APIKEY=
# OPTIMIZELY_SITE_HOSTNAME=
#
# Shared Redis cache (without them, each instance caches in memory)
# REDIS_URL=
# AZURE_CLIENT_ID=
# OPTIMIZELY_DXP_DEPLOYMENT_ID=
#
# CDN cache purge
# OPTIMIZELY_CLOUDPLATFORM_API_URL=
# OPTIMIZELY_CLOUDPLATFORM_API_RESOURCE_ID=
