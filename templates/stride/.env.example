# Base URL of your CMS instance
# Example: https://example.cms.optimizely.com/ or https://localhost:5000
OPTIMIZELY_CMS_URL=

# Content Graph endpoint (optional)
# Use to specify a non-production instance or different version
# Default: https://cg.optimizely.com/content/v2
# OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com/content/v2

# Content Graph authentication key
# Found in: CMS instance > Settings > API Keys
OPTIMIZELY_GRAPH_SINGLE_KEY=

# CLI client credentials for syncing manifest data
# Create in: CMS instance > Settings > API Keys > Create API key
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=

# Base URL for CMS REST API endpoints (optional)
# Default: https://api.cms.optimizely.com/
# OPTIMIZELY_CMS_API_URL=

# Required when CLI connects to local CMS with self-signed certificates
# NODE_TLS_REJECT_UNAUTHORIZED="0"

# ── Storefront v2 (Stride store) ────────────────────────────────────────────

# HMAC-SHA256 signing secret for the signed, httpOnly `stride_store` session
# cookie (docs/storefront-v2/contracts.md §2). Required in every environment
# that serves /api/store/* — locally in .env, and in the Vercel project's
# environment variables for deployed environments.
# Generate a value with:
#   openssl rand -hex 32
STRIDE_COOKIE_SECRET=

# Chrome Origin Trial token for the deployed origin. OPTIONAL — leave empty.
# When non-empty, next.config.ts emits an `Origin-Trial` response header on
# every route; when empty, no header is emitted and behavior is unchanged.
# NOTE: the Origin Trial validates the WebMCP standards / native-registration
# path ONLY. It is NOT native Gemini-in-Chrome support, and no such claim is
# made (docs/storefront-v2/PRD.md §5). Enrollment is a 🔒 Mario-only manual
# step (docs/storefront-v2/issues/0000-parent-afk-execution.md checklist).
ORIGIN_TRIAL_TOKEN=
