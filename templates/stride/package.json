{
  "name": "stride-template",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/store-validate.mjs && node scripts/webmcp-build.mjs && next dev --experimental-https",
    "prebuild": "node scripts/store-validate.mjs",
    "build": "node scripts/webmcp-build.mjs && next build",
    "start": "next start",
    "test": "vitest run",
    "store:validate": "node scripts/store-validate.mjs",
    "webmcp:build": "node scripts/store-validate.mjs && node scripts/webmcp-build.mjs",
    "webmcp:harness": "node scripts/webmcp-harness.mjs",
    "test:webmcp": "playwright test -c tests/webmcp/playwright.config.ts",
    "config:push": "pnpm exec optimizely-cms-cli config push optimizely.config.mjs",
    "test:g1": "playwright test -c tests/demo/playwright.config.ts"
  },
  "dependencies": {
    "@optimizely/cms-sdk": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@optimizely/cms-cli": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
