{
  "name": "@optimizely/cms-sdk",
  "version": "3.0.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "JavaScript tools for integration with Optimizely CMS",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      },
      "require": {
        "types": "./dist/cjs/core/index.d.ts",
        "default": "./dist/cjs/core/index.js"
      }
    },
    "./react/server": {
      "import": {
        "types": "./dist/esm/react/server.d.ts",
        "default": "./dist/esm/react/server.js"
      },
      "require": {
        "types": "./dist/cjs/react/server.d.ts",
        "default": "./dist/cjs/react/server.js"
      }
    },
    "./react/client": {
      "import": {
        "types": "./dist/esm/react/client.d.ts",
        "default": "./dist/esm/react/client.js"
      },
      "require": {
        "types": "./dist/cjs/react/client.d.ts",
        "default": "./dist/cjs/react/client.js"
      }
    },
    "./react/nextjs": {
      "import": {
        "types": "./dist/esm/react/nextjs.d.ts",
        "default": "./dist/esm/react/nextjs.js"
      },
      "require": {
        "types": "./dist/cjs/react/nextjs.d.ts",
        "default": "./dist/cjs/react/nextjs.js"
      }
    },
    "./react/richText": {
      "import": {
        "types": "./dist/esm/react/richText/index.d.ts",
        "default": "./dist/esm/react/richText/index.js"
      },
      "require": {
        "types": "./dist/cjs/react/richText/index.d.ts",
        "default": "./dist/cjs/react/richText/index.js"
      }
    },
    "./buildConfig": {
      "import": {
        "types": "./dist/esm/model/buildConfig.d.ts",
        "default": "./dist/esm/model/buildConfig.js"
      }
    },
    "./telemetry": {
      "import": {
        "types": "./dist/esm/telemetry/index.d.ts",
        "default": "./dist/esm/telemetry/index.js"
      },
      "require": {
        "types": "./dist/cjs/telemetry/index.d.ts",
        "default": "./dist/cjs/telemetry/index.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/esm/schema/index.d.ts",
        "default": "./dist/esm/schema/index.js"
      },
      "require": {
        "types": "./dist/cjs/schema/index.d.ts",
        "default": "./dist/cjs/schema/index.js"
      }
    },
    "./forms/validation": {
      "import": {
        "types": "./dist/esm/forms/validation.d.ts",
        "default": "./dist/esm/forms/validation.js"
      },
      "require": {
        "types": "./dist/cjs/forms/validation.d.ts",
        "default": "./dist/cjs/forms/validation.js"
      }
    },
    "./forms/react": {
      "import": {
        "types": "./dist/esm/react/forms/index.d.ts",
        "default": "./dist/esm/react/forms/index.js"
      },
      "require": {
        "types": "./dist/cjs/react/forms/index.d.ts",
        "default": "./dist/cjs/react/forms/index.js"
      }
    }
  },
  "repository": {
    "url": "https://github.com/episerver/content-js-sdk.git",
    "directory": "packages/optimizely-cms-sdk"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "postbuild": "node scripts/postbuild.js",
    "clean": "rimraf dist",
    "test": "vitest --typecheck"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.0",
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19",
    "jsdom": "^27.0.0",
    "next": "^16.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
