{
  // Base file regardless of build output
  // DO NOT include output options (like `module` and `moduleResolution`)
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__test__/**"]
}
