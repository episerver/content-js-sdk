{
  "name": "@optimizely/cms-sdk-paas",
  "version": "3.0.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Optimizely CMS 13 PaaS support for @optimizely/cms-sdk",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "repository": {
    "url": "https://github.com/episerver/content-js-sdk.git",
    "directory": "packages/optimizely-cms-sdk-paas"
  },
  "scripts": {
    "build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "postbuild": "node scripts/postbuild.js",
    "clean": "rimraf dist",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.0",
  "peerDependencies": {
    "@optimizely/cms-sdk": "workspace:*"
  },
  "devDependencies": {
    "@optimizely/cms-sdk": "workspace:*",
    "@types/node": "^22.13.14",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
