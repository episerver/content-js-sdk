// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PaaS contract > getContent with DAM and taxonomy detected 1`] = `
[
  "
query GetContentMetadata($key: String, $version: String, $metadataLocale: String) {
  _Content(where: { _and: [{ _metadata: { key: { eq: $key }, version: { eq: $version }, locale: { eq: $metadataLocale } } }, { _metadata: { status: { eq: "Published" } } }] }) {
    item {
      _metadata {
        types
        variation
      }
    }
  }
  # Check if "cmp_Asset" type exists which indicates that DAM is enabled
  damAssetType: __type(name: "cmp_Asset") {
    __typename
  }
  taxonomyType: __type(name: "_Metadata") {
    fields(includeDeprecated: false) {
      name
    }
  }
}
",
  "
fragment PublicImageAsset on cmp_PublicImageAsset { Url Title AltText Description MimeType Height Width Renditions { Id Name Url Width Height } FocalPoint { X Y } Tags { Guid Name } }
fragment PublicVideoAsset on cmp_PublicVideoAsset { Url Title AltText Description MimeType Renditions { Id Name Url Width Height } Tags { Guid Name } }
fragment PublicRawFileAsset on cmp_PublicRawFileAsset { Url Title Description MimeType Tags { Guid Name } }
fragment ContentReferenceItem on ContentReference { item { __typename ...PublicImageAsset ...PublicVideoAsset ...PublicRawFileAsset } }
fragment MediaMetadata on MediaMetadata { mimeType thumbnail content }
fragment ItemMetadata on ItemMetadata { changeset displayOption }
fragment InstanceMetadata on InstanceMetadata { changeset locales expired container owner routeSegment lastModifiedBy path createdBy }
fragment ContentUrl on ContentUrl { type default hierarchical internal graph base }
fragment IContentMetadata on IContentMetadata { key locale fallbackForLocale version displayName url {...ContentUrl} types published status created lastModified sortOrder variation ...MediaMetadata ...ItemMetadata ...InstanceMetadata }
fragment _IContent on _IContent { _id _metadata {...IContentMetadata} }
fragment Teaser on Teaser { __typename Teaser__heading:heading image { key url { ...ContentUrl } ...ContentReferenceItem } ..._IContent Teaser__itemMetadata:_itemMetadata { categories } }
fragment ArticlePage on ArticlePage { __typename ArticlePage__title:title ArticlePage__body:body { json } ArticlePage__teasers:teasers { __typename ...Teaser } ..._IContent ArticlePage__itemMetadata:_itemMetadata { categories } }
query GetContent($key: String, $version: String, $metadataLocale: String) {
  _Content(where: { _and: [{ _metadata: { key: { eq: $key }, version: { eq: $version }, locale: { eq: $metadataLocale } } }, { _metadata: { status: { eq: "Published" } } }] }) {
    item {
      __typename
      ...ArticlePage
      _metadata {
        variation
      }
    }
  }
}
  ",
]
`;

exports[`PaaS contract > getContent with DAM and taxonomy detected 2`] = `
{
  "__typename": "ArticlePage",
